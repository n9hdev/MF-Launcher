{
  "name": "mafia-city-anticheat-v6",
  "version": "6.3.6",
  "description": "Mafia City Anti-Cheat V6 - Next generation protection",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:main && npm run build:preload && concurrently \"vite --host 0.0.0.0 --strictPort --port 5173\" \"wait-on http://127.0.0.1:5173 && set NODE_ENV=development&& electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run copy:icon && npm run build:main && npm run build:preload && vite build && electron-builder",
    "copy:icon": "copy \"public\\icon.ico\" \"dist\\icon.ico\" /Y",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.0",
    "axios": "^1.7.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mafia-city.anticheat.v6",
    "productName": "Mafia City Anti-Cheat V6",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
